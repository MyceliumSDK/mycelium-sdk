# >>>>>>>>>>>> OPTIONS 1: SELF-HOSTED <<<<<<<<<<<<
# In case if you want to use your own settings in SDK
# ===================================================

# Privy wallet app id for embedded wallets
PRIVY_APP_ID=
# Privy wallet app secret for embedded wallets
PRIVY_APP_SECRET=

# Chain ID to work with
CHAIN_ID=
# A RPC URL for a chain 
RPC_URL=
# A bundler URL to process User Operations
BUNDLER_URL=

# Optional: Coinbase CDP Api Key ID in case if you want to use on/off ramp functionality
COINBASE_CDP_API_KEY_ID=
# Optional: Coinbase CDP Api secret in case if you want to use on/off ramp functionality
COINBASE_CDP_API_KEY_SECRET=

# Unique integrator ID  that is necessary to track SDK usage and to enable 3d party services, e.g. Coinbase off/on-amp
INTEGRATOR_ID=demo-app


# >>>>>>>>>>>> OPTIONS 2: CLOUD <<<<<<<<<<<<
# In case if you want to use our API key to test SDK
# ===================================================

# If you have an API key and want to run with out settings
API_KEY=
# Fork faucet to top up a smart wallet
BLOCKCHAIN_SERVICE_HOSTNAME=