    "dotenv": "^16.4.5",
    "figlet": "^1.9.4",
    "lowdb": "^7.0.1",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
